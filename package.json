{
  "name": "twilight-coders",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://twilightcoders.github.io/TwilightCoders.net",
  "dependencies": {
    "gh-pages": "^1.1.0",
    "node-sass-chokidar": "^1.2.0",
    "npm-run-all": "^4.1.2",
    "react": "^16.2.0",
    "react-dom": "^16.2.0",
    "react-relay": "^1.5.0",
    "react-scripts": "1.1.1",
    "relay-runtime": "^1.5.0"
  },
  "scripts": {
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "build-css": "node-sass-chokidar src/ -o src/",
    "watch-css": "npm run build-css && node-sass-chokidar src/ -o src/ --watch --recursive",
    "start-js": "node ./setup && react-scripts start",
    "start": "npm-run-all -p watch-css start-js",
    "build-js": "node ./setup && react-scripts build",
    "build": "npm-run-all build-css build-js",
    "relay": "relay-compiler --src ./src --schema ./src/graphql.json",
    "relay-fetch": "node ./fetch-schema",
    "test": "node ./setup && react-scripts test --env=jsdom",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "babel-plugin-relay": "^1.5.0",
    "relay-compiler": "^1.5.0"
  }
}
