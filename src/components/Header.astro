---
// Section links are absolute (/#…) so they work from project pages too.
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#open-source', label: 'Open source' },
  { href: '/#about', label: 'About' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label="Twilight Coders home">
      <svg class="mark-glyph" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
        <path d="M20 6a10 10 0 1 0 6 18 12 12 0 0 1-6-18z" fill="currentColor" />
        <circle cx="9" cy="10" r="1.3" fill="var(--ink-0)" />
        <circle cx="13" cy="6.5" r="0.9" fill="var(--ink-0)" />
      </svg>
      <span class="mark-text">Twilight Coders</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li class="commerce">
          <a href="https://twilightcoders.com/#products">Products<span aria-hidden="true"> ↗</span></a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg-0) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink-0);
    font-size: 1.05rem;
  }

  .mark-glyph {
    color: var(--amber);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.5vw, 1.75rem);
  }

  nav a {
    display: inline-block;
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--ink-1);
    padding-block: 0.6rem;
    border-bottom: 1px solid transparent;
  }

  nav a:hover {
    color: var(--ink-0);
    border-bottom-color: var(--amber-dim);
  }

  .commerce a {
    color: var(--amber);
  }

  @media (max-width: 600px) {
    .mark-text {
      display: none;
    }
    nav a {
      font-size: 0.88rem;
    }
  }
</style>
