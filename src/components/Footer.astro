---
const year = new Date().getFullYear();
---

<section class="handoff" aria-labelledby="handoff-heading">
  <div class="wrap handoff-inner">
    <div>
      <h2 id="handoff-heading">Looking for our apps?</h2>
      <p>upuppy and the rest of our commercial software, with support and contact, live at twilightcoders.com.</p>
    </div>
    <div class="links">
      <a href="https://twilightcoders.com/#products">Products<span aria-hidden="true"> ↗</span></a>
      <a href="https://twilightcoders.com/#contact">Contact<span aria-hidden="true"> ↗</span></a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>© {year} Twilight Coders, LLC · Colorado</p>
    <ul>
      <li><a href="https://github.com/TwilightCoders">GitHub</a></li>
      <li><a href="https://rubygems.org/profiles/voltechs">RubyGems</a></li>
      <li><a href="https://twilightcoders.com">twilightcoders.com</a></li>
    </ul>
  </div>
</footer>

<style>
  .handoff {
    border-top: 1px solid var(--hairline);
    background: var(--bg-1);
  }

  .handoff-inner {
    padding-block: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .handoff h2 {
    font-size: 1.15rem;
  }

  .handoff p {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .links a {
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--ink-0);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.6rem 1.05rem;
  }

  .links a:hover {
    border-color: var(--amber-dim);
    color: var(--amber);
  }

  .site-footer {
    border-top: 1px solid var(--hairline);
  }

  .footer-inner {
    padding-block: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  .footer-inner ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-inner a {
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.3rem;
    display: inline-block;
  }

  .footer-inner a:hover {
    color: var(--amber);
  }
</style>
